# ===== jp-trade environment variables =====
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Database (PostgreSQL — set per environment) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jp_trade?sslmode=require"

# --- Auth secret (required once auth ships in Phase 6) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# --- Public app URL (absolute links, OAuth callbacks) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Redis (optional for development; required for live-market caching) ---
REDIS_URL="redis://localhost:6379"

# --- NSE broker credentials (Shoonya) — empty until live-data wiring ---
BROKER_API_KEY=""
BROKER_USER_ID=""
BROKER_PASSWORD=""
BROKER_ENDPOINT="https://api.shoonya.com"

# --- Market hours (IST, HH:MM 24h) ---
MARKET_OPEN="09:15"
MARKET_CLOSE="15:30"

# --- API rate limiting (optional; sane defaults in src/server/rate-limit.ts) ---
# RATE_LIMIT_WINDOW_MS="60000"
# RATE_LIMIT_MAX="120"
# RATE_LIMIT_SCREEN_MAX="30"
